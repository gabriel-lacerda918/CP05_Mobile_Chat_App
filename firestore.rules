rules_version = '2';

// Responsabilidades:
//  - Escritas em `groups`, `userGroups` e `notificationDispatches` são EXCLUSIVAS da API (Admin SDK ignora as regras).
//    Assim o limite de integrantes, a propriedade do grupo e o espelho de membros no RTDB ficam
//    consistentes (validações que dependem dos dois bancos não cabem nas regras).
//  - O cliente só escreve o próprio perfil, o próprio dispositivo e conversas individuais.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // id da conversa individual = dois uids ordenados
    function directId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function hasDirectConversation(other) {
      return exists(/databases/$(database)/documents/directConversations/$(directId(request.auth.uid, other)));
    }
    // userGroups/{uid}.groupIds é mantido pela API; a interseção indica grupo em comum
    function sharesGroup(other) {
      return exists(/databases/$(database)/documents/userGroups/$(request.auth.uid))
        && exists(/databases/$(database)/documents/userGroups/$(other))
        && get(/databases/$(database)/documents/userGroups/$(request.auth.uid)).data.groupIds
             .hasAny(get(/databases/$(database)/documents/userGroups/$(other)).data.groupIds);
    }

    function validPublic(d) {
      return d.keys().hasOnly(['name', 'photoUrl', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.photoUrl is string && d.photoUrl.size() <= 500
        && d.createdAt is number;
    }

    function validUser(d) {
      return d.keys().hasOnly(['name', 'email', 'phoneNumber', 'birthDate', 'photoUrl', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.email is string && d.email.lower() == request.auth.token.email.lower()
        && d.phoneNumber is string && d.phoneNumber.matches('^[0-9]{10,13}$')
        && d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.photoUrl is string && d.photoUrl.size() <= 500
        && d.createdAt is number;
    }

    function validDevice(d, deviceId) {
      return d.keys().hasOnly(['token', 'tokenType', 'platform', 'enabled', 'updatedAt', 'disabledReason'])
        && d.token == deviceId
        && d.tokenType in ['fcm', 'expo']
        && d.platform in ['android', 'ios']
        && d.enabled is bool
        && d.updatedAt is number;
    }

    // Nome e foto: qualquer usuário autenticado (necessário para a lista de usuários)
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && validPublic(request.resource.data);
      allow update: if isSelf(uid) && validPublic(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Dados cadastrais: só o dono ou quem compartilha conversa individual / grupo
    match /users/{uid} {
      allow get: if isSelf(uid) || (signedIn() && (hasDirectConversation(uid) || sharesGroup(uid)));
      allow list: if false;
      allow create: if isSelf(uid) && validUser(request.resource.data);
      allow update: if isSelf(uid) && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // Tokens de dispositivo: nunca públicos (a API lê com Admin SDK)
      match /devices/{deviceId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validDevice(request.resource.data, deviceId);
        allow delete: if false;
      }
    }

    match /directConversations/{conversationId} {
      allow get: if signedIn() && request.auth.uid in conversationId.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participantIds', 'createdAt'])
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && conversationId == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
        && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    // Grupos: leitura só por integrantes ativos; escrita somente pela API
    match /groups/{groupId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }

    match /userGroups/{uid} { allow read, write: if false; }
    match /notificationDispatches/{id} { allow read, write: if false; }
  }
}
