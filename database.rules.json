{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      ".read": false,
      ".write": false
    },
    "messages": {
      "$convId": {
        ".read": "auth != null && (root.child('members').child($convId).child(auth.uid).val() === true || $convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid))",
        "$msgId": {
          ".write": "auth != null && !data.exists() && newData.exists() && (root.child('members').child($convId).child(auth.uid).val() === true || $convId.beginsWith(auth.uid + '_') || $convId.endsWith('_' + auth.uid))",
          ".validate": "newData.hasChildren(['conversationType', 'senderId', 'text', 'target', 'createdAt']) && (newData.child('conversationType').val() === 'group' ? root.child('members').child($convId).child(auth.uid).val() === true : !root.child('members').child($convId).exists())",
          "conversationType": { ".validate": "newData.val() === 'direct' || newData.val() === 'group'" },
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "target": {
            ".validate": "newData.hasChild('type')",
            "type": { ".validate": "newData.val() === 'conversation' || newData.val() === 'member'" },
            "memberId": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "$other": { ".validate": false }
          },
          "mentionedUserIds": {
            "$i": { ".validate": "newData.isString() && newData.val().length <= 128" }
          },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 600000" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
